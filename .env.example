EMAIL_DRY_RUN=1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_sender@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password

EMAIL_FROM=your_alert_sender@gmail.com
EMAIL_TO=your_receiver@gmail.com

# Export these into the shell (the Python services do not implicitly load .env).
# Sensitive API routes return 503 until a locally generated key is configured.
SYMPTOM_AI_API_KEY=
# Required by: docker compose --env-file ../.env up -d
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
